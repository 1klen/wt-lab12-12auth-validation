@page
@model wt_lab5_5mvc_leshkevich.Pages.Cars.IndexModel
@{
    ViewData["Title"] = "Каталог автомобилей";
    Layout = "_Layout";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Каталог автомобилей</h1>
            <p class="text-muted">Список доступных транспортных средств</p>
        </div>
        <a asp-page="Create" class="btn btn-primary">Добавить автомобиль</a>
    </div>

    <form method="get" class="row g-2 mb-4">
        <div class="col-sm-8 col-md-6">
            <input type="text"
                   name="Search"
                   value="@Model.Search"
                   class="form-control"
                   placeholder="Марка или модель" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-dark">Найти</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            <div class="col-auto">
                <a asp-page="Index" class="btn btn-outline-secondary">Сбросить</a>
            </div>
        }
    </form>

    <div class="row g-4">
        @foreach (var car in Model.Cars)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm rounded-4">
                    <div class="card-body">
                        <span class="badge bg-secondary mb-2">ID: @car.Id</span>
                        <h5 class="card-title">@car.BrandModel</h5>
                        <p class="text-muted mb-1">Категория: @car.Category</p>
                        <p class="mb-2">Статус: @(car.IsAvailable ? "Доступен" : "Занят")</p>
                        <p class="fs-4 fw-bold">@car.PricePerDay BYN / сутки</p>
                        <div class="d-flex flex-wrap gap-2">
                            <a asp-page="Details" asp-route-id="@car.Id" class="btn btn-outline-primary btn-sm">Подробнее</a>
                            <a asp-page="Edit" asp-route-id="@car.Id" class="btn btn-outline-warning btn-sm">Изменить</a>
                            <a asp-page="Delete" asp-route-id="@car.Id" class="btn btn-outline-danger btn-sm">Удалить</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>